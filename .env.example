# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk → Webhooks → endpoint https://<your-domain>/api/webhook/clerk, events user.created, user.updated, user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pinecone — create a 1024-dim cosine index named radar-jobs
PINECONE_API_KEY=
PINECONE_INDEX_NAME=radar-jobs

# Protects every /api/cron/* route and /api/scrape. REQUIRED in production: without it the automatic
# loop answers 401 and jobs are never refreshed. Set it in Vercel (Vercel Cron then sends it) and as a
# GitHub Actions secret together with RADAR_URL. Any long random string: `openssl rand -hex 32`.
CRON_SECRET=

# OVERCLOCK resume tailoring: set the key of at least one provider. Each tailoring is one paid AI call.
# AI_PROVIDER picks who writes first (anthropic | gemini | grok); every other provider with a key is a
# fallback when the first is down, rate limited or rejects its key. Models are optional overrides.
AI_PROVIDER=
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview   (default: the top model; falls back to gemini-3.8-flash on its own)
# https://console.x.ai
XAI_API_KEY=
# XAI_MODEL=grok-4.7

# Gmail link (read-only), used to spot rejections / interviews / offers.
# Google Cloud → APIs & Services: enable the Gmail API, create an OAuth client (Web application) and add the
# redirect URI  https://<your-domain>/api/gmail/callback  (and http://localhost:3000/api/gmail/callback for dev).
# While the OAuth app is in "Testing", add yourself as a test user; Google then expires the link every 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored Gmail refresh token (AES-256-GCM). Any long random string; changing it unlinks Gmail.
GMAIL_TOKEN_KEY=

# ---- Pipeline tuning (all optional) ----
# Search terms used for Workday tenants and Amazon (they list thousands of roles)
RADAR_SEARCH_TERMS=software engineer,developer,data
# Comma list of title keywords a job must contain; set RADAR_TITLE_FILTER=off to keep every role
# RADAR_TITLE_KEYWORDS=engineer,developer,data,intern
# RADAR_MAX_JOBS_PER_COMPANY=150
# RADAR_MAX_EMBEDS_PER_RUN=2000
# RADAR_SCRAPE_CONCURRENCY=4
# RADAR_REMOTIVE_CATEGORIES=software-dev,data
# Job-board sources. Adzuna (developer.adzuna.com) and Jooble (jooble.org/api/about) are skipped until their keys are set.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# RADAR_ADZUNA_COUNTRIES=in,gb,de,nl,fr,sg,us
# JOOBLE_API_KEY=
# RADAR_JOOBLE_LOCATIONS=India|United Kingdom|Germany|Netherlands|Remote
# RADAR_JOBICY_INDUSTRIES=engineering,data-science
# RADAR_MUSE_LOCATIONS=Flexible / Remote|Bengaluru, India|London, United Kingdom|Berlin, Germany|Amsterdam, Netherlands
# RADAR_MUSE_PAGES=3
# Similarity band stretched onto 0-100 in the match score (see src/lib/ai/matcher.ts)
# RADAR_SIM_FLOOR=0.72
# RADAR_SIM_CEIL=0.88

# Keep auth on our own pages
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ---- Public site (optional) ----
# Canonical URL for the sitemap, robots.txt and link previews. Defaults to the Vercel production domain.
# NEXT_PUBLIC_SITE_URL=https://radar.example.com
# Shown on /privacy and /terms as the contact address.
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
